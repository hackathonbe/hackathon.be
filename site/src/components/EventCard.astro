---
// A hackathon in a list: date and place on the left, name and summary on the right.
import { AUDIENCE_LABELS, TYPE_LABELS } from '../lib/event-fields';
import { endDay, eventPath, formatDateRange, placeLabel, type EventEntry } from '../lib/events';

interface Props {
  event: EventEntry;
  /** Show the year in the date, for lists that are not grouped by month. */
  withYear?: boolean;
}

const { event, withYear = false } = Astro.props;
const { data } = event;
const showAudience = data.audience && data.audience !== 'open';
const hasTags = data.status !== 'scheduled' || data.type !== 'hackathon' || showAudience;
---

<li
  class="hb-panel p-6 transition-colors hover:border-white/25"
  data-event-end={endDay(event)}
>
  <div class="flex flex-col md:flex-row gap-3 md:gap-8">
    <div class="md:w-56 flex-shrink-0">
      <div class="font-mono text-lg font-medium text-accent">{formatDateRange(event, withYear)}</div>
      <div class="text-sm text-muted mt-1">{placeLabel(event)}</div>
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="hb-h3">
        <a href={eventPath(event)} class="hover:underline underline-offset-4">{data.name}</a>
      </h3>
      {data.organizer && <p class="text-sm text-muted mt-1">{data.organizer}</p>}
      {data.description && <p class="text-muted leading-relaxed mt-3">{data.description}</p>}
      {
        hasTags && (
          <div class="flex flex-wrap gap-2 mt-4">
            {data.status !== 'scheduled' && <span class="hb-tag hb-tag-alert">{data.status}</span>}
            {data.type !== 'hackathon' && <span class="hb-tag hb-tag-accent">{TYPE_LABELS[data.type]}</span>}
            {showAudience && data.audience && <span class="hb-tag">{AUDIENCE_LABELS[data.audience]}</span>}
          </div>
        )
      }
    </div>
  </div>
</li>
