---
// A hackathon in a list: date and place on the left, name and summary on the right.
import { AUDIENCE_LABELS, TYPE_LABELS } from '../lib/event-fields';
import { endDay, eventPath, formatDateRange, placeLabel, type EventEntry } from '../lib/events';

interface Props {
  event: EventEntry;
  /** Show the year in the date, for lists that are not grouped by month. */
  withYear?: boolean;
}

const { event, withYear = false } = Astro.props;
const { data } = event;
const showAudience = data.audience && data.audience !== 'open';
const hasTags = data.status !== 'scheduled' || data.type !== 'hackathon' || showAudience;
---

<li
  class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow"
  data-event-end={endDay(event)}
>
  <div class="flex flex-col md:flex-row gap-3 md:gap-6">
    <div class="md:w-56 flex-shrink-0">
      <div class="text-lg font-bold text-blue-600">{formatDateRange(event, withYear)}</div>
      <div class="text-sm text-gray-500 mt-1">{placeLabel(event)}</div>
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="text-xl font-semibold">
        <a href={eventPath(event)} class="hover:text-blue-600 hover:underline">{data.name}</a>
      </h3>
      {data.organizer && <p class="text-sm text-gray-500 mt-1">{data.organizer}</p>}
      {data.description && <p class="text-gray-600 mt-3">{data.description}</p>}
      {
        hasTags && (
          <div class="flex flex-wrap gap-2 mt-3">
            {data.status !== 'scheduled' && (
              <span class="text-xs font-semibold uppercase tracking-wide bg-red-50 text-red-700 px-2 py-1 rounded">
                {data.status}
              </span>
            )}
            {data.type !== 'hackathon' && (
              <span class="text-xs font-medium bg-blue-50 text-blue-700 px-2 py-1 rounded">
                {TYPE_LABELS[data.type]}
              </span>
            )}
            {showAudience && data.audience && (
              <span class="text-xs font-medium bg-gray-100 text-gray-700 px-2 py-1 rounded">
                {AUDIENCE_LABELS[data.audience]}
              </span>
            )}
          </div>
        )
      }
    </div>
  </div>
</li>
