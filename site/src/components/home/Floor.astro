---
import { Image } from 'astro:assets';
import teamwork from '../../assets/photos/swleuven.jpg';
import networking from '../../assets/photos/networking.jpg';
import vrHackathon from '../../assets/photos/vrhackathon.jpg';

const photos = [
  { src: teamwork, alt: 'Team working together at hackathon', caption: 'Startup Weekend Leuven' },
  { src: networking, alt: 'Networking at hackathon event', caption: 'Between two sprints' },
  { src: vrHackathon, alt: 'Coding and building at hackathon', caption: 'VR hackathon' },
];
---
<section id="floor" style="border-bottom: 1px solid rgba(255,255,255,0.08)">
<div style="max-width: 1240px; margin: 0 auto; padding: 72px 32px; display: flex; flex-direction: column; gap: 28px">
<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 32px">
<div style="display: flex; align-items: center; gap: 12px; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent)"><span style="width: 8px; height: 8px; background: var(--accent); display: inline-block"></span>From the floor</div>
<div style="font-size: 14px; color: #A3ACB9">Photos from hackathons across Belgium.</div>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px">
{photos.map((photo) => (
<figure style="margin: 0; display: flex; flex-direction: column; gap: 12px">
<div style="position: relative; aspect-ratio: 4 / 3; border-radius: 16px; border: 1px solid rgba(255,255,255,0.1); background: #12161D; overflow: hidden">
<Image src={photo.src} alt={photo.alt} widths={[400, 800]} sizes="(min-width: 1240px) 392px, (min-width: 640px) 33vw, 100vw" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block" />
</div>
<figcaption style="font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; letter-spacing: 0.06em; color: #A3ACB9">{photo.caption}</figcaption>
</figure>
))}
</div>
</div>
</section>
