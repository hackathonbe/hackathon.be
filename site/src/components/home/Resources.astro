---
import { Image } from 'astro:assets';
import cover from '../../assets/photos/Hackathon-fake-book-cover.png';
import canvas from '../../assets/photos/thehackathoncanvas.png';
---
<section id="resources" style="border-bottom: 1px solid rgba(255,255,255,0.08)">
<div style="max-width: 1240px; margin: 0 auto; padding: 112px 32px; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-direction: column; gap: 20px; max-width: 760px">
<div style="display: flex; align-items: center; gap: 12px; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent)"><span style="width: 8px; height: 8px; background: var(--accent); display: inline-block"></span>Free resources</div>
<h2 style="font-family: 'Bricolage Grotesque', 'Arial Black', sans-serif; font-optical-sizing: auto; font-weight: 800; font-size: clamp(34px, 3.6vw, 52px); line-height: 1.02; letter-spacing: -0.03em; margin: 0; text-wrap: balance; color: #F3F5F7">Two things we made for you. Both free.</h2>
<p style="font-size: 18px; line-height: 1.6; color: #A3ACB9; margin: 0; max-width: 640px">Whether you're joining your first hackathon or organising your tenth.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr)); gap: 20px">
<div style="background: var(--accent); color: #0B0E13; border-radius: 24px; padding: 40px; display: flex; flex-wrap: wrap; gap: 32px; justify-content: space-between; align-items: flex-end; min-height: 340px; position: relative; overflow: hidden">
<div style="display: flex; flex-direction: column; gap: 20px; max-width: 360px; flex: 1 1 280px">
<div style="font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: #0B0E13">Free study · 85 pages · 2017</div>
<h3 style="font-family: 'Bricolage Grotesque', 'Arial Black', sans-serif; font-optical-sizing: auto; font-weight: 800; font-size: clamp(32px, 3vw, 44px); line-height: 1; letter-spacing: -0.035em; margin: 0; color: #0B0E13">130 hackathons, analysed.</h3>
<p style="font-size: 16px; line-height: 1.55; margin: 0; color: #0B0E13; opacity: 0.8">Everything we learned from 130 Belgian hackathons, in 85 pages. The most complete picture of the scene — yours for free.</p>
<a href="/130-hackathons-analyzed-for-you" class="hb-btn" style="display: inline-flex; align-items: center; gap: 10px; align-self: flex-start; min-height: 48px; padding: 0 20px; border-radius: 12px; background: #0B0E13; color: #F3F5F7; font-size: 15px; font-weight: 600">Get the study — free<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M4 20h16"></path></svg></a>
</div>
<Image src={cover} alt="How to organize great hackathons — book cover" width={220} height={220} densities={[1, 2]} loading="lazy" style="width: 220px; height: 220px; flex: 0 0 auto; display: block" />
</div>
<div style="background: #12161D; border: 1px solid rgba(255,255,255,0.1); border-radius: 24px; padding: 40px; display: flex; flex-wrap: wrap; gap: 32px; justify-content: space-between; align-items: flex-end; min-height: 340px">
<div style="display: flex; flex-direction: column; gap: 20px; max-width: 360px; flex: 1 1 280px">
<div style="font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent)">Free tool · For organisers</div>
<h3 style="font-family: 'Bricolage Grotesque', 'Arial Black', sans-serif; font-optical-sizing: auto; font-weight: 800; font-size: clamp(32px, 3vw, 44px); line-height: 1; letter-spacing: -0.035em; margin: 0; color: #F3F5F7">The Hackathon Canvas.</h3>
<p style="font-size: 16px; line-height: 1.55; margin: 0; color: #A3ACB9">A free framework to plan and organise your hackathon, from first idea to demo day.</p>
<a href="/the-hackathon-canvas-a-free-resource-to-organize-your-hackathon" style="display: inline-flex; align-items: center; gap: 10px; align-self: flex-start; min-height: 48px; padding: 0 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.18); color: #F3F5F7; font-size: 15px; font-weight: 500">Download the canvas<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M4 20h16"></path></svg></a>
</div>
<Image src={canvas} alt="The Hackathon Canvas" width={240} densities={[1, 2]} loading="lazy" style="width: 240px; height: auto; flex: 0 0 auto; display: block; border-radius: 8px" />
</div>
</div>
</div>
</section>
