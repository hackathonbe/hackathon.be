---
// A hackathon as one line in a long list: date, name, place.
import { TYPE_LABELS } from '../lib/event-fields';
import { eventPath, formatDateRange, placeLabel, type EventEntry } from '../lib/events';

interface Props {
  event: EventEntry;
  upcoming?: boolean;
}

const { event, upcoming = false } = Astro.props;
const { data } = event;
---

<li class="py-3 grid gap-x-6 gap-y-1 sm:grid-cols-[11rem_minmax(0,1fr)_9rem]">
  <span class="font-mono text-sm font-medium text-accent">{formatDateRange(event, false)}</span>
  <span class="min-w-0">
    <a href={eventPath(event)} class="font-medium text-fg hover:underline underline-offset-4">{data.name}</a>
    {data.type !== 'hackathon' && <span class="hb-tag hb-tag-accent ml-2">{TYPE_LABELS[data.type]}</span>}
    {upcoming && <span class="hb-tag hb-tag-accent ml-2">Upcoming</span>}
  </span>
  <span class="text-sm text-muted">{placeLabel(event)}</span>
</li>
