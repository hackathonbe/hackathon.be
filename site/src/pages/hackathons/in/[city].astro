---
import Layout from '../../../layouts/Layout.astro';
import EventCard from '../../../components/EventCard.astro';
import {
  cityPath,
  getPublishedEvents,
  groupByCity,
  isUpcoming,
  slugify,
  todayInBelgium,
  type CityGroup,
} from '../../../lib/events';

export async function getStaticPaths() {
  const cities = groupByCity(await getPublishedEvents());
  return cities.map((group) => ({
    params: { city: slugify(group.city) },
    props: { group, others: cities.filter((other) => other.city !== group.city) },
  }));
}

interface Props {
  group: CityGroup;
  others: CityGroup[];
}

const { group, others } = Astro.props;
const { city, events } = group;
const today = todayInBelgium();
const upcoming = events.filter((event) => isUpcoming(event, today));
const past = events.filter((event) => !isUpcoming(event, today)).reverse();

const title = `Hackathons in ${city} - Hackathon Belgium`;
const description = `Hackathons, game jams and similar events in ${city}, Belgium: what is coming up and what has taken place, with dates, organisers and links.`;
---

<Layout title={title} description={description} url={cityPath(city)}>
  <div class="hb-wrap hb-page">
    <nav class="hb-label mb-8" aria-label="Breadcrumb">
      <a href="/hackathons/" class="hover:underline underline-offset-4">All hackathons</a>
    </nav>

    <div class="hb-narrow flex flex-col gap-5 mb-14">
      <div class="hb-eyebrow">City</div>
      <h1 class="hb-h1">Hackathons in {city}</h1>
    </div>

    <h2 class="hb-h2 mb-6">Upcoming</h2>
    {
      upcoming.length > 0 ? (
        <ul class="space-y-4">
          {upcoming.map((event) => (
            <EventCard event={event} withYear />
          ))}
        </ul>
      ) : (
        <p class="hb-text">
          No upcoming hackathons are listed in {city} right now. See the
          <a href="/calendar" class="hb-link">calendar</a> for the rest of Belgium.
        </p>
      )
    }

    {
      past.length > 0 && (
        <>
          <h2 class="hb-h2 mb-6 mt-16">Past events</h2>
          <ul class="space-y-4">
            {past.map((event) => (
              <EventCard event={event} withYear />
            ))}
          </ul>
        </>
      )
    }

    <h2 class="hb-label mt-20 pt-8 hb-rule mb-4">Other cities</h2>
    <ul class="flex flex-wrap gap-2">
      {
        others.map((other) => (
          <li>
            <a href={other.path} class="hb-pill">{other.city}</a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
