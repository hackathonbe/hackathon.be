---
import Layout from '../../../layouts/Layout.astro';
import EventCard from '../../../components/EventCard.astro';
import {
  cityPath,
  getPublishedEvents,
  groupByCity,
  isUpcoming,
  slugify,
  todayInBelgium,
  type CityGroup,
} from '../../../lib/events';

export async function getStaticPaths() {
  const cities = groupByCity(await getPublishedEvents());
  return cities.map((group) => ({
    params: { city: slugify(group.city) },
    props: { group, others: cities.filter((other) => other.city !== group.city) },
  }));
}

interface Props {
  group: CityGroup;
  others: CityGroup[];
}

const { group, others } = Astro.props;
const { city, events } = group;
const today = todayInBelgium();
const upcoming = events.filter((event) => isUpcoming(event, today));
const past = events.filter((event) => !isUpcoming(event, today)).reverse();

const title = `Hackathons in ${city} - Hackathon Belgium`;
const description = `Hackathons, game jams and similar events in ${city}, Belgium: what is coming up and what has taken place, with dates, organisers and links.`;
---

<Layout title={title} description={description} url={cityPath(city)}>
  <div class="max-w-4xl mx-auto">
    <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/hackathons/" class="hover:text-blue-600 hover:underline">All hackathons</a>
    </nav>

    <h1 class="text-4xl font-bold mb-12">Hackathons in {city}</h1>

    <h2 class="text-3xl font-bold mb-6 mt-8">Upcoming</h2>
    {
      upcoming.length > 0 ? (
        <ul class="space-y-6">
          {upcoming.map((event) => (
            <EventCard event={event} withYear />
          ))}
        </ul>
      ) : (
        <p class="text-gray-600">
          No upcoming hackathons are listed in {city} right now. See the
          <a href="/calendar" class="text-blue-600 hover:underline">calendar</a> for the rest of
          Belgium.
        </p>
      )
    }

    {
      past.length > 0 && (
        <>
          <h2 class="text-3xl font-bold mb-6 mt-12">Past events</h2>
          <ul class="space-y-6">
            {past.map((event) => (
              <EventCard event={event} withYear />
            ))}
          </ul>
        </>
      )
    }

    <h2 class="text-2xl font-bold mb-4 mt-16 pt-8 border-t border-gray-200">Other cities</h2>
    <ul class="flex flex-wrap gap-2">
      {
        others.map((other) => (
          <li>
            <a
              href={other.path}
              class="inline-block bg-white border border-gray-200 hover:border-blue-600 hover:text-blue-600 text-gray-700 text-sm px-3 py-1.5 rounded-full transition-colors"
            >
              {other.city}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
