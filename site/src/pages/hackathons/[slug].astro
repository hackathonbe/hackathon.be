---
import Layout from '../../layouts/Layout.astro';
import { AUDIENCE_LABELS, FORMAT_LABELS, TYPE_LABELS } from '../../lib/event-fields';
import {
  REPO_URL,
  cityPath,
  eventJsonLd,
  eventPath,
  formatDateRange,
  formatLongDate,
  formatMonthYear,
  getPublishedEvents,
  isUpcoming,
  jsonLdString,
  languageList,
  placeLabel,
  type EventEntry,
} from '../../lib/events';

export async function getStaticPaths() {
  const events = await getPublishedEvents();
  return events.map((event) => ({
    params: { slug: event.id },
    props: {
      event,
      // Other editions of the same recurring event, newest first.
      editions: event.data.series
        ? events
            .filter((other) => other.id !== event.id && other.data.series === event.data.series)
            .reverse()
        : [],
    },
  }));
}

interface Props {
  event: EventEntry;
  editions: EventEntry[];
}

const { event, editions } = Astro.props;
const { data } = event;
const upcoming = isUpcoming(event);
const when = formatDateRange(event);
const place = placeLabel(event);
const typeLabel = TYPE_LABELS[data.type];
const where = [data.venue, data.city].filter(Boolean).join(', ') || place;

const title = `${data.name} - ${place}, ${data.start_date ? formatMonthYear(data.start_date) : ''}`;
const description = `${typeLabel} in ${data.city ?? 'Belgium'}, ${when}. ${data.description ?? ''}`.trim();
const jsonLd = eventJsonLd(event);
const editUrl = `${REPO_URL}/edit/main/site/src/content/events/${event.id}.yaml`;

const facts = [
  ['When', when],
  ['Where', where],
  ['Organised by', data.organizer],
  ['Format', data.format && FORMAT_LABELS[data.format]],
  ['Who can join', data.audience && AUDIENCE_LABELS[data.audience]],
  ['Language', languageList(event)],
  ['Themes', data.themes.join(', ')],
  ['Edition', data.edition],
].filter(([, value]) => Boolean(value));
---

<Layout title={title} description={description} url={eventPath(event)}>
  {jsonLd && <script type="application/ld+json" set:html={jsonLdString(jsonLd)} />}

  <article class="hb-wrap hb-page">
    <nav class="hb-label mb-8" aria-label="Breadcrumb">
      <a href="/hackathons/" class="hover:underline underline-offset-4">All hackathons</a>
      {
        data.city && (
          <>
            <span aria-hidden="true"> / </span>
            <a href={cityPath(data.city)} class="hover:underline underline-offset-4">
              {data.city}
            </a>
          </>
        )
      }
    </nav>

    <div class="hb-narrow">
      <div class="flex flex-wrap gap-2 mb-6">
        {data.status !== 'scheduled' && <span class="hb-tag hb-tag-alert">{data.status}</span>}
        <span class="hb-tag hb-tag-accent">{typeLabel}</span>
        <span class="hb-tag">{upcoming ? 'Upcoming' : 'Past event'}</span>
      </div>

      <h1 class="hb-h1 mb-5">{data.name}</h1>
      <p class="font-mono text-lg font-medium text-accent mb-8">{when} · {place}</p>

      {data.description && <p class="hb-lead mb-10">{data.description}</p>}

      <dl class="hb-panel px-6 py-2 mb-10 divide-y divide-white/10">
        {
          facts.map(([label, value]) => (
            <div class="py-4 sm:grid sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-6">
              <dt class="hb-label sm:pt-1">{label}</dt>
              <dd class="text-fg break-words">{value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="flex flex-col sm:flex-row flex-wrap gap-3 mb-16">
        {
          data.url && (
            <a href={data.url} target="_blank" rel="noopener noreferrer" class="hb-cta">
              Visit the event website
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          )
        }
        {
          data.city && (
            <a href={cityPath(data.city)} class="hb-cta-ghost">
              More hackathons in {data.city}
            </a>
          )
        }
      </div>

      {
        editions.length > 0 && (
          <section class="mb-16">
            <h2 class="hb-h2 mb-6">Other editions</h2>
            <ul class="hb-panel divide-y divide-white/10 px-6">
              {editions.map((edition) => (
                <li class="py-3 flex flex-wrap gap-x-4 gap-y-1">
                  <a href={eventPath(edition)} class="font-medium hover:underline underline-offset-4">
                    {edition.data.name}
                  </a>
                  <span class="text-muted text-sm">
                    {formatDateRange(edition)} · {placeLabel(edition)}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <aside class="text-sm text-muted leading-relaxed hb-rule pt-6">
        {
          data.listed_by === 'organizer' ? (
            <p>This listing was provided by the organiser.</p>
          ) : (
            <p>
              Hackathon Belgium put this listing together from public sources
              {data.checked_on && <> and last checked it on {formatLongDate(data.checked_on)}</>}. It
              is not an official page of the event.
            </p>
          )
        }
        <p class="mt-2">
          Is this your event, or is something wrong?
          <a href="/submit/" class="hb-link">Tell us</a> or
          <a href={editUrl} target="_blank" rel="noopener noreferrer" class="hb-link"
            >edit this listing on GitHub</a
          >.
        </p>
      </aside>
    </div>
  </article>
</Layout>
