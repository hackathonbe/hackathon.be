---
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';
import {
  getPublishedEvents,
  groupByMonth,
  isUpcoming,
  startDay,
  todayInBelgium,
} from '../lib/events';

const description =
  'Find upcoming hackathons in Belgium. Browse our calendar of tech events, coding competitions, and innovation challenges happening across the country.';

const today = todayInBelgium();
const upcoming = (await getPublishedEvents()).filter((event) => isUpcoming(event, today));
// Events that have started but not ended go first, under their own heading.
const ongoing = upcoming.filter((event) => startDay(event) < today);
const months = groupByMonth(upcoming.filter((event) => startDay(event) >= today));
---

<Layout title="Hackathon Calendar - Belgium" description={description} url="/calendar">
  <div class="hb-wrap hb-page">
    <div class="hb-narrow flex flex-col gap-5 mb-14">
      <div class="hb-eyebrow">Calendar</div>
      <h1 class="hb-h1">Hackathon Calendar</h1>
      <p class="hb-lead">
        Upcoming hackathons in Belgium, earliest first. You can also follow them in your own calendar
        with the <a href="/calendar.ics" class="hb-link">calendar feed</a>.
      </p>
    </div>

    {
      ongoing.length > 0 && (
        <section class="mb-12" data-month-group>
          <h2 class="hb-label mb-4">Happening now</h2>
          <ul class="space-y-4">
            {ongoing.map((event) => (
              <EventCard event={event} />
            ))}
          </ul>
        </section>
      )
    }

    {
      months.map((month) => (
        <section class="mb-12" data-month-group>
          <h2 class="hb-label mb-4">{month.label}</h2>
          <ul class="space-y-4">
            {month.events.map((event) => (
              <EventCard event={event} />
            ))}
          </ul>
        </section>
      ))
    }

    <p id="no-upcoming" class="hb-text py-6" hidden={upcoming.length > 0}>
      No upcoming hackathons are listed right now. Know of one? Submit it below.
    </p>

    <p class="hb-text">
      Looking for an earlier event?
      <a href="/hackathons/" class="hb-link">Browse all hackathons</a>, past and upcoming.
    </p>

    <div class="hb-rule mt-20 pt-16 scroll-mt-8" id="submit">
      <div class="hb-narrow flex flex-col gap-5 mb-10">
        <div class="hb-eyebrow">For organisers</div>
        <h2 class="hb-h2">Submit your hackathon</h2>
      </div>
      <div class="rounded-2xl overflow-hidden bg-white p-2">
        <div class="typeform-widget" data-url="https://hackathonbelgium.typeform.com/to/NVPAI3" style="width: 100%; height: 500px;"></div> <script> (function() { var qs,js,q,s,d=document, gi=d.getElementById, ce=d.createElement, gt=d.getElementsByTagName, id="typef_orm", b="https://embed.typeform.com/"; if(!gi.call(d,id)) { js=ce.call(d,"script"); js.id=id; js.src=b+"embed.js"; q=gt.call(d,"script")[0]; q.parentNode.insertBefore(js,q) } })() </script> <div style="font-family: Sans-Serif;font-size: 12px;color: #999;opacity: 0.5; padding-top: 5px;"> powered by <a href="https://admin.typeform.com/signup?utm_campaign=NVPAI3&amp;utm_source=typeform.com-14717312-Free&amp;utm_medium=typeform&amp;utm_content=typeform-embedded-poweredbytypeform&amp;utm_term=EN" style="color: #999" target="_blank" rel="noopener noreferrer">Typeform</a> </div>
      </div>
    </div>

    <script is:inline>
      // The page is built once a day. Between builds, drop events that have ended.
      (function () {
        var today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Brussels' }).format(new Date());
        document.querySelectorAll('[data-event-end]').forEach(function (item) {
          if (item.getAttribute('data-event-end') < today) item.remove();
        });
        document.querySelectorAll('[data-month-group]').forEach(function (group) {
          if (!group.querySelector('[data-event-end]')) group.remove();
        });
        if (!document.querySelector('[data-event-end]')) {
          var empty = document.getElementById('no-upcoming');
          if (empty) empty.hidden = false;
        }
      })();
    </script>
  </div>
</Layout>
